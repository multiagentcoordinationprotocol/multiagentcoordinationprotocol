{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macp.dev/schemas/macp-parity-contract.schema.json",
  "title": "MACP Cross-Implementation Parity Contract",
  "description": "Validates the SHAPE of schemas/parity/contract.json. This schema enforces structure only (type/pattern/enum/uniqueItems/minItems/minLength) -- it does NOT verify that the pinned VALUES are actually correct against their real sources. That is scripts/check-parity-contract.py's job. See schemas/parity/README.md; this manifest is non-normative.",
  "$defs": {
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "macp-runtime",
          "macp-sdk-python",
          "macp-sdk-typescript"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^(_|\\$comment)": {}
  },
  "required": [
    "contract_version",
    "sections"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(_|\\$comment)": {}
      },
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "macp_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "applies_to",
            "source",
            "macp_version"
          ]
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "standard": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)*\\.v[0-9]+$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "extension": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)*\\.v[0-9]+$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "applies_to",
            "source",
            "standard",
            "extension"
          ]
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "mode_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "configuration_version": {
              "type": "string",
              "minLength": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "policy_builder_schema_version": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          "required": [
            "applies_to",
            "source",
            "mode_version",
            "configuration_version",
            "policy_version",
            "policy_builder_schema_version"
          ]
        },
        "error_codes": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "permanent": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "deprecated": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "applies_to",
            "source",
            "permanent",
            "deprecated"
          ]
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0
            },
            "backoff_base_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "backoff_max_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "backoff_schedule_seconds": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 1
            },
            "retryable_error_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "jitter": {
              "type": "boolean"
            }
          },
          "required": [
            "applies_to",
            "source",
            "max_retries",
            "backoff_base_seconds",
            "backoff_max_seconds",
            "backoff_schedule_seconds",
            "retryable_error_codes",
            "jitter"
          ]
        },
        "projection_anomaly": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "field_case_rule": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "applies_to",
            "source",
            "kinds",
            "fields",
            "field_case_rule"
          ]
        },
        "commitment_hash": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "accept": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reject": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "applies_to",
            "source",
            "pattern",
            "accept",
            "reject"
          ]
        },
        "contribute_payload": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "canonical_encoding": {
              "type": "string",
              "enum": [
                "protobuf"
              ]
            },
            "decode_order": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "json",
                  "protobuf"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            },
            "first_byte": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^(_|\\$comment)": {}
              },
              "properties": {
                "protobuf": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{2}$"
                },
                "legacy_json": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{2}$"
                }
              },
              "required": [
                "protobuf",
                "legacy_json"
              ]
            },
            "vectors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^(_|\\$comment)": {}
                },
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "value": {
                    "type": "string"
                  },
                  "protobuf_hex": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})+$"
                  },
                  "legacy_json_hex": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})+$"
                  },
                  "decode_only": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "value",
                  "protobuf_hex"
                ]
              }
            }
          },
          "required": [
            "applies_to",
            "source",
            "canonical_encoding",
            "decode_order",
            "first_byte",
            "vectors"
          ]
        },
        "contribute_acceptance": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "empty_payload": {
              "type": "string",
              "enum": [
                "accept",
                "reject"
              ]
            }
          },
          "required": [
            "applies_to",
            "source",
            "empty_payload"
          ]
        },
        "proposal_disposition": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(_|\\$comment)": {}
          },
          "properties": {
            "applies_to": {
              "$ref": "#/$defs/appliesTo"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "mode_state_dispositions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "projection_status_values": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "acceptance_tracking": {
              "type": "string",
              "enum": [
                "per_sender",
                "per_proposal"
              ]
            }
          },
          "required": [
            "applies_to",
            "source",
            "mode_state_dispositions",
            "projection_status_values",
            "acceptance_tracking"
          ]
        }
      },
      "required": [
        "protocol",
        "modes",
        "defaults",
        "error_codes",
        "retry",
        "projection_anomaly",
        "commitment_hash",
        "contribute_payload",
        "contribute_acceptance",
        "proposal_disposition"
      ]
    }
  }
}
