{
  "_def": "AgentExtension",
  "_invalid_because": "params.macpVersions lists Envelope.macp_version values such as \"1.0\" (RFC-MACP-0014 §3); \"v1\" is not a version string.",
  "uri": "https://multiagentcoordinationprotocol.io/a2a/extensions/macp/v1",
  "description": "MACP coordination sessions.",
  "required": true,
  "params": {
    "macpVersions": [
      "v1"
    ],
    "modes": [
      "macp.mode.decision.v1",
      "ext.multi_round.v1"
    ],
    "transport": "macp.transport.a2a.v1",
    "manifestUrl": "https://runtime.example.com/.well-known/macp.json"
  }
}
